# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
# Production / Docker: postgresql://ev_user:ev_pass@localhost:5432/smart_mobility?sslmode=disable
# Embedded Local Mode (default when DATABASE_URL is omitted or pglite://): uses @electric-sql/pglite persisted to .data/pgdata
DATABASE_URL=pglite://.data/pgdata
ENABLE_POSTGIS=false

# Authentication & Security (Generate 32+ char secrets in production)
AUTH_SECRET=dev-only-replace-with-32-char-random-secret-key
QR_SIGNING_SECRET=dev-only-replace-with-32-char-qr-signing-secret

# Google OAuth 2.0 / OIDC (Optional — create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit callback override; defaults dynamically to <origin>/api/v1/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# Redis (Optional for distributed SSE / rate-limiting; in-memory coordinator used if omitted)
REDIS_URL=

# Maps & EV Station Discovery (100% Free / Zero Billing)
# Public EV chargers work automatically via:
#   1. Bundled India EV Charging Dataset (ODbL v1.0, 28,553 sites across ChargeZone, MG eHUB, Kia/Numocity, Ather Grid, Bolt.Earth)
#   2. Free keyless BEE India EV Directory API (ev-charging-stations-api.vercel.app)
#   3. OpenStreetMap Overpass API + Leaflet + OSRM routing (zero API keys required)
# Optional: Open Charge Map API key for enriched community EV charger metadata (free registration at openchargemap.org)
OPEN_CHARGE_MAP_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Payment Gateway (Sandbox mode by default — NEVER use live keys without production verification)
PAYMENT_GATEWAY_MODE=sandbox
RAZORPAY_KEY_ID=rzp_test_sandbox_demo_key
RAZORPAY_KEY_SECRET=rzp_test_sandbox_demo_secret
RAZORPAY_WEBHOOK_SECRET=whsec_test_sandbox_webhook_secret

# Pricing & Platform Defaults
PLATFORM_FEE_BPS=500
DEFAULT_TAX_BPS=1800
HOLD_TTL_SECONDS=600
